/// Connection to the gold layer. The endpoint is environment-specific
/// and is substituted at deploy time by push_semantic_model.py.
expression DatabaseQuery =
		let
		    database = Sql.Database("@@sqlendpoint@@", "@@database@@")
		in
		    database
	lineageTag: d7a32812-6b1e-5f1c-9218-dbe0eceac0b7
	annotation PBI_IncludeFutureArtifacts = False
	annotation PBI_NavigationStepName = Navigation
