/// Workplace access and occupancy for the CxO dashboards. Badge reads at five Manhattan office buildings, by person, building, day and minute. Answers four questions: how full the buildings are, when people arrive, which companies use the space they lease, and how many badges are live.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["DatabaseQuery"]

ref table Arrivals
ref table Cardholder
ref table Building
ref table Company
ref table Reader
ref table 'Time of Day'
ref table 'User Scope'
ref table Date

ref expression DatabaseQuery

ref relationship 915cfbc1-0abd-568a-addf-432dbdc17c6b
ref relationship 04ca8b5f-4728-500d-a7da-fb57ba053305
ref relationship 08bb3430-8507-50bf-9904-5720e4a4230d
ref relationship 6973733d-858c-5896-af80-89023064f319
ref relationship 925eb479-8437-575b-8360-83cc02396a6e
ref relationship 8a86f97d-578c-5ee7-9f71-cdb1ee5af713

ref role 'Building Scope'
