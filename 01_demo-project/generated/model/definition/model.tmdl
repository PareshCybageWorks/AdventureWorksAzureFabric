/// Commerce star schema over wh_gold. One fact (Sales) and three conformed dimensions. Every business definition -- revenue, margin, recognised revenue -- lives here as a measure so reports cannot disagree about them.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["DatabaseQuery"]

ref table Sales
ref table Customer
ref table Product
ref table Date
ref table Audit

ref expression DatabaseQuery

ref relationship 42cd6ef2-3fed-55fe-80cb-eb91a46e7757
ref relationship ac4516aa-5732-553d-998f-4e96cfe98fb2
ref relationship 89417ae1-41a4-5c39-b6d0-e40c85490ed6
